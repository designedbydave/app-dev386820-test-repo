{
  "name": "change-velocity-demo",
  "version": "1.0.0",
  "description": "Astro + React demo app for ServiceNow DevOps Change Velocity and the deployment change gate",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "serve": "node scripts/serve.mjs dist 4321",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=test-results/unit/junit.xml",
    "test:smoke": "node --test \"smoke/**/*.test.mjs\"",
    "test:smoke:ci": "mkdir -p test-results/smoke && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/smoke/junit.xml \"smoke/**/*.test.mjs\"",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "astro": "^7.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
