---
import PipelineTracker from '../components/PipelineTracker';
import { getReleaseInfo } from '../lib/release';
import '../styles/global.css';

const release = getReleaseInfo();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Change Velocity Demo</title>
  </head>
  <body>
    <main>
      <header>
        <p class="eyebrow">ServiceNow DevOps Change Velocity</p>
        <h1>Change Velocity Demo</h1>
        <p class="lede">
          Every push to <code>main</code> builds once, deploys to TEST with an automatic change receipt, then waits
          at a ServiceNow change gate before production.
        </p>
      </header>

      <dl class="release" data-testid="release">
        <div><dt>Version</dt><dd id="version">{release.version}</dd></div>
        <div><dt>Commit</dt><dd title={release.sha}>{release.shortSha}</dd></div>
        <div><dt>Built</dt><dd>{release.builtAt}</dd></div>
        {release.runUrl && <div><dt>Run</dt><dd><a href={release.runUrl}>GitHub Actions</a></dd></div>}
      </dl>

      <h2>Pipeline</h2>
      <PipelineTracker client:load />
    </main>
  </body>
</html>
